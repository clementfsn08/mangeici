{
  "version": 2,

  "routes": [
    {
      "src": "/$",
      "dest": "/mangeici-mvp.html"
    },
    {
      "src": "/restaurants",
      "dest": "/mangeici-mvp.html"
    },
    {
      "src": "/inscription",
      "dest": "/mangeici-inscription.html"
    },
    {
      "src": "/connexion",
      "dest": "/mangeici-login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/mangeici-dashboard.html"
    },
    {
      "src": "/admin",
      "dest": "/mangeici-admin.html"
    },
    {
      "src": "/vision",
      "dest": "/mangeici-vision.html"
    },
    {
      "src": "/profil/(.*)",
      "dest": "/mangeici-profil-resto.html?id=$1"
    },
    {
      "src": "/avis",
      "dest": "/mangeici-laisser-avis.html"
    },
    {
      "src": "/compte",
      "dest": "/mangeici-compte.html"
    },
    {
      "src": "/suggestions",
      "dest": "/mangeici-suggestions.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.fedapay.com https://api.fontshare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://api.fontshare.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co https://api.fedapay.com https://app.fedapay.com; frame-src https://cdn.fedapay.com https://app.fedapay.com; object-src 'none';"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|png|jpg|svg)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
